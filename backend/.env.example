NODE_ENV=development
PORT=5000

# Aiven MySQL — replace with your actual credentials
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/microjob?ssl-mode=REQUIRED"

# JWT — use strong random values in production: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend URL (for CORS)
# Production: https://tomarkaj.com
FRONTEND_URL=http://localhost:5173

# File uploads
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# ─── Cloudflare R2 File Storage ───────────────────────────────────────────────
# Required for production. Leave blank for local dev (falls back to base64).
# Create an R2 bucket in Cloudflare → Settings → R2 → Manage R2 API Tokens
#
# R2_ACCOUNT_ID      = Cloudflare Account ID (from https://dash.cloudflare.com)
# R2_ACCESS_KEY_ID   = R2 API Token Access Key ID
# R2_SECRET_ACCESS_KEY = R2 API Token Secret
# R2_BUCKET_NAME     = Your R2 bucket name (e.g. tomarkaj-production)
# R2_PUBLIC_BASE_URL = Custom public domain for CDN assets (e.g. https://cdn.tomarkaj.com)
#                      Only used for public assets. Proof files always use signed URLs.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
